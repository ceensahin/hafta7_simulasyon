import random
def MCarlo(n):
    A=0
    B=0

    for i in range (n):
        x = random.random()*10
        y = random.random()*10

        if x**2 + y**2 <1:
            B+= 1
        elif (x**2 + y**2) <9 and (x**2 + y**2) >4:
            A+= 1


    G= A/B
    print(A)
    print(B)
    print(G)

MCarlo(1000000)
